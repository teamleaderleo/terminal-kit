{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "app": {
    "hideTabCloseButton": true,
    "commandPaletteSearchesAllSurfaces": true,
    "newWorkspacePlacement": "afterCurrent",
    "workspaceInheritWorkingDirectory": false,
    "focusPaneOnFirstClick": true,
    "openSupportedFilesInCmux": true,
    "openMarkdownInCmuxViewer": true,
    "windowTitleTemplate": "{activeWorkspace} — {activeDirectory}"
  },
  "terminal": {
    "copyOnSelect": false,
    "showScrollBar": false,
    "scrollSpeed": 1.4,
    "showTextBoxOnNewTerminals": false,
    "focusTextBoxOnNewTerminals": false,
    "textBoxMaxLines": 6,
    "rendererRealization": {
      "enabled": true,
      "idleSeconds": 30,
      "maxWarmRenderers": 12
    },
    "agentHibernation": {
      "enabled": false,
      "idleSeconds": 5,
      "maxLiveTerminals": 12
    }
  },
  "sidebar": {
    "wrapWorkspaceTitles": false,
    "showWorkspaceDescription": false,
    "branchLayout": "inline",
    "showNotificationMessage": false,
    "notificationMessageLineLimit": 1,
    "showBranchDirectory": false,
    "showPullRequests": false,
    "watchGitStatus": false,
    "showPorts": false,
    "showLog": false,
    "showProgress": false,
    "showAgentActivity": true,
    "showCustomMetadata": true,
    "loadingSpinnerPosition": "trailing",
    "notificationBadgePosition": "trailing"
  },
  "workspaceColors": {
    "indicatorStyle": "solidFill",
    "selectionColor": "#313244",
    "notificationBadgeColor": "#9AA4C8",
    "colors": {
      "Indigo": "#6876A5",
      "Periwinkle": "#7885B5",
      "Slate": "#566074",
      "Sage": "#60756D",
      "Rose": "#8B6878"
    }
  },
  "sidebarAppearance": {
    "matchTerminalBackground": true,
    "tintOpacity": 0.88
  },
  "shortcuts": {
    "showModifierHoldHints": true,
    "bindings": {
      "newSurface": "cmd+t",
      "closeTab": "cmd+w",
      "reopenClosedBrowserPanel": "cmd+shift+t",
      "nextSurface": "ctrl+tab",
      "prevSurface": "ctrl+shift+tab",
      "browserBack": "cmd+[",
      "browserForward": "cmd+]",
      "focusBrowserAddressBar": "cmd+l",
      "find": "cmd+f"
    }
  },
  "markdown": {
    "fontSize": 16,
    "maxWidth": 860
  },
  "fileEditor": {
    "wordWrap": true
  },
  "fileExplorer": {
    "doubleClickAction": "preview"
  },
  "actions": {
    "terminal-kit.copyCommand": {
      "type": "command",
      "title": "Copy Last Command",
      "subtitle": "Copy the previous shell command to the macOS clipboard",
      "keywords": ["copy", "clipboard", "command", "shell"],
      "command": "terminal-kit copy command",
      "target": "currentTerminal",
      "palette": true,
      "icon": { "type": "symbol", "name": "doc.on.doc" }
    },
    "terminal-kit.copyScreen": {
      "type": "command",
      "title": "Copy Visible Screen",
      "subtitle": "Copy the current cmux terminal screen to the macOS clipboard",
      "keywords": ["copy", "clipboard", "screen", "output", "terminal"],
      "command": "terminal-kit copy screen",
      "target": "currentTerminal",
      "palette": true,
      "icon": { "type": "symbol", "name": "rectangle.on.rectangle" }
    },
    "terminal-kit.copyPath": {
      "type": "command",
      "title": "Copy Current Path",
      "subtitle": "Copy the current working directory to the macOS clipboard",
      "keywords": ["copy", "clipboard", "path", "directory", "cwd"],
      "command": "terminal-kit copy path",
      "target": "currentTerminal",
      "palette": true,
      "icon": { "type": "symbol", "name": "folder" }
    },
    "terminal-kit.copyProject": {
      "type": "command",
      "title": "Copy Project Path",
      "subtitle": "Copy the Git root, or the current directory outside Git",
      "keywords": ["copy", "clipboard", "project", "git", "root"],
      "command": "terminal-kit copy project",
      "target": "currentTerminal",
      "palette": true,
      "icon": { "type": "symbol", "name": "folder.badge.gearshape" }
    }
  },
  "ui": {
    "surfaceTabBar": {
      "buttons": [
        "cmux.newTerminal",
        "cmux.newBrowser",
        "cmux.splitRight",
        "cmux.splitDown",
        { "action": "terminal-kit.copyCommand", "title": "Copy Cmd" },
        { "action": "terminal-kit.copyScreen", "title": "Copy Screen" },
        { "action": "terminal-kit.copyPath", "title": "Copy Path" }
      ]
    }
  },
  "commands": [
    {
      "name": "Sidebar: Quiet",
      "description": "Keep titles and agent attention; hide supporting detail",
      "keywords": ["sidebar", "density", "quiet"],
      "command": "terminal-kit set sidebar quiet"
    },
    {
      "name": "Sidebar: Details",
      "description": "Show paths, PRs and bounded notifications without changing theme",
      "keywords": ["sidebar", "density", "details"],
      "command": "terminal-kit set sidebar details"
    },
    {
      "name": "Workspace: Overview",
      "description": "Browse every cmux window and workspace in one calm full-screen view",
      "keywords": ["workspace", "window", "overview", "switcher", "expose"],
      "command": "terminal-kit overview"
    },
    {
      "name": "Agent: Work Here",
      "description": "Create a reversible task checkout and open an agent for the current project",
      "keywords": ["agent", "work", "task", "codex", "claude", "worktree"],
      "command": "terminal-kit work"
    },
    {
      "name": "Karabiner: Export Portable Settings",
      "description": "Capture portable Karabiner mappings from the selected profile into terminal-kit",
      "keywords": ["karabiner", "keyboard", "export", "sync", "keys"],
      "command": "terminal-kit karabiner export"
    },
    {
      "name": "Karabiner: Sync Settings",
      "description": "Merge terminal-kit Karabiner mappings into the selected local profile",
      "keywords": ["karabiner", "keyboard", "apply", "sync", "keys"],
      "command": "terminal-kit karabiner sync"
    },
    {
      "name": "Theme: Browse",
      "description": "Preview and select a cmux terminal theme",
      "keywords": ["theme", "appearance", "colour"],
      "command": "terminal-kit theme browse"
    },
    {
      "name": "Theme: Next Favourite",
      "description": "Move to the next theme in the saved top group",
      "keywords": ["theme", "cycle", "next"],
      "command": "terminal-kit theme next"
    },
    {
      "name": "Theme: Readability Test",
      "description": "Render ANSI, source code, and diff samples",
      "keywords": ["theme", "contrast", "accessibility", "test"],
      "command": "terminal-kit theme test"
    },
    {
      "name": "Hints: Show Next",
      "description": "Explicitly place one shortcut hint in the current workspace row",
      "keywords": ["hints", "keys", "shortcuts", "learn", "sidebar"],
      "command": "terminal-kit hints next"
    },
    {
      "name": "Hints: Clear",
      "description": "Remove the optional terminal-kit hint from this workspace",
      "keywords": ["hints", "clear", "sidebar"],
      "command": "terminal-kit hints clear"
    },
    {
      "name": "Keys: Cheat Sheet",
      "description": "Preview the compact terminal-kit and cmux key list",
      "keywords": ["keys", "shortcuts", "commands", "help", "cheat sheet"],
      "command": "terminal-kit keys | less -R"
    },
    {
      "name": "Prompt: Minimal",
      "description": "Use the calm directory-only shell prompt",
      "keywords": ["prompt", "minimal", "calm", "git"],
      "command": "terminal-kit set prompt minimal"
    },
    {
      "name": "Prompt: Detailed",
      "description": "Show Git branch and repository state in the shell prompt",
      "keywords": ["prompt", "detailed", "git", "branch", "status"],
      "command": "terminal-kit set prompt detailed"
    },
    {
      "name": "Performance: Benchmark Shell",
      "description": "Compare bare and configured Zsh startup time",
      "keywords": ["performance", "speed", "benchmark", "zsh", "startup"],
      "command": "terminal-kit perf shell"
    },
    {
      "name": "Memory: Normal",
      "description": "Keep twelve terminal renderers warm; agents stay live",
      "keywords": ["memory", "normal", "renderer", "ram"],
      "command": "terminal-kit set memory normal"
    },
    {
      "name": "Memory: Lean",
      "description": "Keep two renderers warm and hibernate idle agents above four",
      "keywords": ["memory", "lean", "hibernate", "ram"],
      "command": "terminal-kit set memory lean"
    },
    {
      "name": "Memory: Task Manager",
      "description": "Show actual CPU and memory use by cmux surface",
      "keywords": ["memory", "task manager", "top", "cpu", "ram"],
      "command": "cmux top"
    },
    {
      "name": "Cloud VMs: List",
      "description": "List cmux Cloud VMs and their current provider state",
      "keywords": ["vm", "cloud", "machine", "status"],
      "command": "cmux vm list | less -R"
    },
    {
      "name": "Files: Yazi",
      "description": "Open the fast terminal file manager in this directory",
      "keywords": ["files", "browse", "manager", "yazi"],
      "command": "y"
    },
    {
      "name": "Git: Lazygit",
      "description": "Open an interactive Git dashboard for this repository",
      "keywords": ["git", "status", "commit", "branch", "lazygit"],
      "command": "lazygit"
    },
    {
      "name": "System: btop",
      "description": "Open the interactive system and process monitor",
      "keywords": ["system", "cpu", "memory", "process", "btop"],
      "command": "btop"
    }
  ]
}
