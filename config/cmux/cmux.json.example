{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "app": {
    "hideTabCloseButton": true,
    "commandPaletteSearchesAllSurfaces": true
  },
  "terminal": {
    "copyOnSelect": true,
    "showScrollBar": false,
    "showTextBoxOnNewTerminals": false,
    "focusTextBoxOnNewTerminals": false,
    "textBoxMaxLines": 6
  },
  "sidebar": {
    "wrapWorkspaceTitles": false,
    "showWorkspaceDescription": true,
    "branchLayout": "inline",
    "showNotificationMessage": true,
    "notificationMessageLineLimit": 2,
    "showBranchDirectory": true,
    "showPullRequests": true,
    "showPorts": true,
    "showLog": true,
    "showProgress": true,
    "showAgentActivity": true,
    "loadingSpinnerPosition": "trailing",
    "notificationBadgePosition": "trailing"
  },
  "workspaceColors": {
    "indicatorStyle": "washRail",
    "selectionColor": "#3A324A",
    "notificationBadgeColor": "#C6A0F6",
    "colors": {
      "Lavender": "#8F7AAE",
      "Mauve": "#765D8F",
      "Rose": "#A96D87",
      "Sage": "#657B6D",
      "Slate": "#566074"
    }
  },
  "sidebarAppearance": {
    "matchTerminalBackground": false,
    "tintColor": "#241F31",
    "darkModeTintColor": "#241F31",
    "lightModeTintColor": "#EEEAF4",
    "tintOpacity": 0.78
  }
}
