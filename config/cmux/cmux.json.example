{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "app": {
    "hideTabCloseButton": true,
    "commandPaletteSearchesAllSurfaces": true,
    "newWorkspacePlacement": "afterCurrent",
    "workspaceInheritWorkingDirectory": false,
    "focusPaneOnFirstClick": true,
    "openSupportedFilesInCmux": true,
    "openMarkdownInCmuxViewer": true,
    "windowTitleTemplate": "{activeWorkspace} — {activeDirectory}"
  },
  "terminal": {
    "copyOnSelect": true,
    "showScrollBar": false,
    "scrollSpeed": 1.4,
    "showTextBoxOnNewTerminals": false,
    "focusTextBoxOnNewTerminals": false,
    "textBoxMaxLines": 6,
    "rendererRealization": {
      "enabled": true,
      "idleSeconds": 15,
      "maxWarmRenderers": 6
    },
    "agentHibernation": {
      "enabled": false,
      "idleSeconds": 5,
      "maxLiveTerminals": 8
    }
  },
  "sidebar": {
    "wrapWorkspaceTitles": false,
    "showWorkspaceDescription": false,
    "branchLayout": "inline",
    "showNotificationMessage": false,
    "notificationMessageLineLimit": 1,
    "showBranchDirectory": false,
    "showPullRequests": false,
    "watchGitStatus": false,
    "showPorts": false,
    "showLog": false,
    "showProgress": false,
    "showAgentActivity": true,
    "showCustomMetadata": true,
    "loadingSpinnerPosition": "trailing",
    "notificationBadgePosition": "trailing"
  },
  "workspaceColors": {
    "indicatorStyle": "solidFill",
    "selectionColor": "#313244",
    "notificationBadgeColor": "#9AA4C8",
    "colors": {
      "Indigo": "#6876A5",
      "Periwinkle": "#7885B5",
      "Slate": "#566074",
      "Sage": "#60756D",
      "Rose": "#8B6878"
    }
  },
  "sidebarAppearance": {
    "matchTerminalBackground": true,
    "tintOpacity": 0.88
  },
  "shortcuts": {
    "showModifierHoldHints": true
  },
  "markdown": {
    "fontSize": 16,
    "maxWidth": 860
  },
  "fileEditor": {
    "wordWrap": true
  },
  "fileExplorer": {
    "doubleClickAction": "preview"
  },
  "commands": [
    {
      "name": "Workspace: Overview",
      "description": "Browse every cmux window and workspace in one full-screen view",
      "keywords": ["workspace", "window", "overview", "switcher", "expose"],
      "command": "terminal-kit overview"
    },
    {
      "name": "Theme: Browse",
      "description": "Preview and select a cmux terminal theme",
      "keywords": ["theme", "appearance", "colour"],
      "command": "terminal-kit theme browse"
    },
    {
      "name": "Theme: Next Favourite",
      "description": "Move to the next theme in the saved top group",
      "keywords": ["theme", "cycle", "next"],
      "command": "terminal-kit theme next"
    },
    {
      "name": "Theme: Readability Test",
      "description": "Render ANSI, source code, and diff samples",
      "keywords": ["theme", "contrast", "accessibility", "test"],
      "command": "terminal-kit theme test"
    },
    {
      "name": "Glass: Cycle",
      "description": "Cycle regular, clear, immersive, and opaque presets",
      "keywords": ["glass", "opacity", "blur", "liquid"],
      "command": "terminal-kit glass cycle"
    },
    {
      "name": "Scroll: Cycle Speed",
      "description": "Cycle precise, balanced, brisk, and fast terminal scrolling",
      "keywords": ["scroll", "mouse", "wheel", "speed", "mos"],
      "command": "terminal-kit scroll cycle"
    },
    {
      "name": "Sidebar: Compact Minimum",
      "description": "Allow the workspace sidebar to shrink to 180 points after restart",
      "keywords": ["sidebar", "tabs", "compact", "width"],
      "command": "terminal-kit sidebar compact"
    },
    {
      "name": "Editor: Toggle Word Wrap",
      "description": "Switch the built-in editor between wrapping and horizontal scrolling",
      "keywords": ["editor", "wrap", "horizontal", "scroll", "wide"],
      "command": "terminal-kit editor toggle"
    },
    {
      "name": "Hints: Show Next",
      "description": "Explicitly place one shortcut hint in the current workspace row",
      "keywords": ["hints", "keys", "shortcuts", "learn", "sidebar"],
      "command": "terminal-kit hints next"
    },
    {
      "name": "Hints: Clear",
      "description": "Remove the optional terminal-kit hint from this workspace",
      "keywords": ["hints", "clear", "sidebar"],
      "command": "terminal-kit hints clear"
    },
    {
      "name": "Keys: Cheat Sheet",
      "description": "Preview the compact terminal-kit and cmux key list",
      "keywords": ["keys", "shortcuts", "commands", "help", "cheat sheet"],
      "command": "terminal-kit keys | less -R"
    },
    {
      "name": "Prompt: Minimal",
      "description": "Use the calm directory-only shell prompt",
      "keywords": ["prompt", "minimal", "calm", "git"],
      "command": "terminal-kit prompt minimal"
    },
    {
      "name": "Prompt: Detailed",
      "description": "Show Git branch and repository state in the shell prompt",
      "keywords": ["prompt", "detailed", "git", "branch", "status"],
      "command": "terminal-kit prompt detailed"
    },
    {
      "name": "Performance: Benchmark Shell",
      "description": "Compare bare and configured Zsh startup time",
      "keywords": ["performance", "speed", "benchmark", "zsh", "startup"],
      "command": "terminal-kit perf shell"
    },
    {
      "name": "Memory: Choose Mode",
      "description": "Choose automatic, normal, balanced, lean, or ultra memory policy",
      "keywords": ["memory", "ram", "idle", "hibernate", "renderer"],
      "command": "terminal-kit memory menu"
    },
    {
      "name": "Memory: Automatic On",
      "description": "Follow native macOS normal, warning, and critical memory pressure",
      "keywords": ["memory", "automatic", "pressure", "ram", "kernel"],
      "command": "terminal-kit memory auto on"
    },
    {
      "name": "Memory: Automatic Off",
      "description": "Stop automatic changes and keep the current effective policy",
      "keywords": ["memory", "automatic", "off", "manual", "ram"],
      "command": "terminal-kit memory auto off"
    },
    {
      "name": "Memory: Balanced",
      "description": "Keep six terminal renderers warm without hibernating agents",
      "keywords": ["memory", "balanced", "renderer", "ram"],
      "command": "terminal-kit memory balanced"
    },
    {
      "name": "Memory: Lean",
      "description": "Keep two renderers warm and hibernate idle agents above four",
      "keywords": ["memory", "lean", "hibernate", "ram"],
      "command": "terminal-kit memory lean"
    },
    {
      "name": "Memory: Ultra",
      "description": "Keep one renderer warm and hibernate idle agents above two",
      "keywords": ["memory", "ultra", "hibernate", "ram"],
      "command": "terminal-kit memory ultra"
    },
    {
      "name": "Memory: Task Manager",
      "description": "Show actual CPU and memory use by cmux surface",
      "keywords": ["memory", "task manager", "top", "cpu", "ram"],
      "command": "terminal-kit memory top"
    },
    {
      "name": "Cloud VMs: List",
      "description": "List cmux Cloud VMs and their current provider state",
      "keywords": ["vm", "cloud", "machine", "status"],
      "command": "cmux vm list | less -R"
    },
    {
      "name": "Files: Yazi",
      "description": "Open the fast terminal file manager in this directory",
      "keywords": ["files", "browse", "manager", "yazi"],
      "command": "y"
    },
    {
      "name": "Git: Lazygit",
      "description": "Open an interactive Git dashboard for this repository",
      "keywords": ["git", "status", "commit", "branch", "lazygit"],
      "command": "lazygit"
    },
    {
      "name": "System: btop",
      "description": "Open the interactive system and process monitor",
      "keywords": ["system", "cpu", "memory", "process", "btop"],
      "command": "btop"
    }
  ]
}
