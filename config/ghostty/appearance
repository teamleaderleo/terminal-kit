# terminal-kit: theme-responsive appearance shared by Ghostty and cmux

# Catppuccin Mocha is the fallback. `terminal-kit theme ...` writes cmux's
# managed override so the complete palette can rotate without these settings
# masking the selected theme.
theme = Catppuccin Mocha
minimum-contrast = 3

# Keep inactive splits readable while making the focused pane slightly clearer.
unfocused-split-opacity = 0.96

# Slightly larger and thicker macOS text improves distance legibility without
# turning the terminal into a bold display face.
font-family = Menlo
font-size = 13
font-thicken = true
font-thicken-strength = 32
sidebar-font-size = 14
surface-tab-bar-font-size = 11

# Balanced padding keeps the grid centred as panes are resized.
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-padding-color = extend
window-inherit-font-size = true

cursor-style = block
cursor-style-blink = false
