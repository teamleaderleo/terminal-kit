# terminal-kit: deep indigo appearance shared by Ghostty and cmux

# Ben Davis uses GitHub Dark Default in his editor. Start from the matching
# terminal palette, then pull the base toward a quieter, desaturated indigo.
theme = GitHub Dark Default
background = #171923
foreground = #D8DBE8
cursor-color = #93A4E8
cursor-text = #171923
selection-background = #30364A
selection-foreground = #F4F6FB
split-divider-color = #2A2F3E
minimum-contrast = 3
background-opacity = 1
unfocused-split-opacity = 1

# JetBrains Mono is free, crisp on Retina displays, and already installed.
font-family = JetBrains Mono
font-size = 14
font-thicken = true
window-padding-x = 10
window-padding-y = 10
cursor-style = block
cursor-style-blink = false
