# terminal-kit: theme-responsive appearance shared by Ghostty and cmux

# Catppuccin Mocha is the fallback. `terminal-kit theme ...` writes cmux's
# managed override so the complete palette can rotate without these settings
# masking the selected theme.
theme = Catppuccin Mocha
minimum-contrast = 3

# Noticeable but still readable native macOS glass. Ghostty maps this special
# blur value to the macOS 26 system glass material rather than a third-party
# shader or imitation effect.
background-opacity = 0.94
background-blur = macos-glass-regular
background-opacity-cells = false
unfocused-split-opacity = 1

# Menlo gives this a lighter, compact macOS Terminal feel on Retina displays.
font-family = Menlo
font-size = 12.5
font-thicken = false
window-padding-x = 10
window-padding-y = 10
cursor-style = block
cursor-style-blink = false
