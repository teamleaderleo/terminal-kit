# terminal-kit: calm lavender appearance shared by Ghostty and cmux

# Catppuccin supplies balanced ANSI colours; these overrides make the base
# quieter, darker, and a little more Apple-like.
theme = Catppuccin Macchiato
background = #1E1A2B
foreground = #DAD7E5
cursor-color = #C6A0F6
cursor-text = #1E1A2B
selection-background = #4A405B
selection-foreground = #F4F1FA
split-divider-color = #3A3348
minimum-contrast = 3
background-opacity = 1
unfocused-split-opacity = 1

# JetBrains Mono ships with Ghostty and stays crisp on Retina displays.
font-family = JetBrains Mono
font-size = 14
font-thicken = true
window-padding-x = 10
window-padding-y = 10
cursor-style = block
cursor-style-blink = false
