# terminal-kit: deep indigo appearance shared by Ghostty and cmux

# GitHub Dark Default supplies the ANSI palette; the overrides pull the base
# toward a quieter, desaturated indigo.
theme = GitHub Dark Default
background = #171923
foreground = #D8DBE8
cursor-color = #93A4E8
cursor-text = #171923
selection-background = #30364A
selection-foreground = #F4F6FB
split-divider-color = #2A2F3E
minimum-contrast = 3

# Noticeable but still readable native macOS glass. Ghostty maps this special
# blur value to the macOS 26 system glass material rather than a third-party
# shader or imitation effect.
background-opacity = 0.94
background-blur = macos-glass-regular
background-opacity-cells = false
unfocused-split-opacity = 1

# Menlo gives this a lighter, compact macOS Terminal feel on Retina displays.
font-family = Menlo
font-size = 12.5
font-thicken = false
window-padding-x = 10
window-padding-y = 10
cursor-style = block
cursor-style-blink = false
