# terminal-kit: deep indigo appearance shared by Ghostty and cmux

# Ben Davis uses GitHub Dark Default in his editor. Start from the matching
# terminal palette, then pull the base toward a quieter, desaturated indigo.
theme = GitHub Dark Default
background = #171923
foreground = #D8DBE8
cursor-color = #93A4E8
cursor-text = #171923
selection-background = #30364A
selection-foreground = #F4F6FB
split-divider-color = #2A2F3E
minimum-contrast = 3

# Barely-there translucency: enough depth to feel native without reducing
# readability. macOS 26 uses the system's regular Liquid Glass material.
background-opacity = 0.975
background-blur = macos-glass-regular
background-opacity-cells = false
unfocused-split-opacity = 1

# Menlo gives this a lighter, compact macOS Terminal feel on Retina displays.
font-family = Menlo
font-size = 12.5
font-thicken = false
window-padding-x = 10
window-padding-y = 10
cursor-style = block
cursor-style-blink = false
