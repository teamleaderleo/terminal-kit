# terminal-kit: Ghostty and cmux terminal behaviour

scrollback-limit = 10000000
mouse-hide-while-typing = true
cursor-click-to-move = true
shell-integration = zsh
# Keep working-directory and prompt reporting while preventing completed commands
# such as `tk` from replacing cmux's project-oriented workspace label.
shell-integration-features = no-title
link-previews = osc8

# Long-running commands should announce completion after you have moved elsewhere,
# without adding terminal bells while you are already watching the command finish.
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 15s

# New top-level workspaces start at home. cmux can still open an explicit project
# directory, while tabs and splits inside a project keep their own live context.
working-directory = home

# Clipboard and screen selection.
# Selecting text never touches the clipboard; Cmd+C copies the selection, as in
# any other macOS app. Right-click keeps the familiar Copy/Paste context menu.
# Deliberate keyboard pastes may contain multiple lines without a confirmation prompt.
clipboard-read = ask
clipboard-write = allow
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = false
copy-on-select = false
right-click-action = context-menu
mouse-shift-capture = never
selection-clear-on-typing = true
selection-clear-on-copy = false

# Treat the left Option key as terminal Alt/Meta for Neovim and other TUIs while
# leaving the right Option key available for ordinary macOS symbol entry.
macos-option-as-alt = left

# Cmd+A/C/Z keep Ghostty's own screen meanings. Keys that must reach the shell
# use standard encodings, so programs other than Zsh never receive private codes.

# Cursor movement and selection.
keybind = cmd+left=text:\x01
keybind = cmd+right=text:\x05
keybind = cmd+shift+left=csi:1;2H
keybind = cmd+shift+right=csi:1;2F
keybind = shift+left=csi:1;2D
keybind = shift+right=csi:1;2C
keybind = option+left=esc:b
keybind = option+right=esc:f
keybind = option+shift+left=csi:1;4D
keybind = option+shift+right=csi:1;4C

# Shell integration marks command boundaries. Jump through previous output blocks
# rather than manually hunting through a long scrollback buffer.
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

# Deletion.
keybind = cmd+backspace=text:\x15
keybind = cmd+delete=text:\x0b
keybind = option+backspace=text:\x17
keybind = option+delete=esc:d

# Cmd+V remains a real terminal paste, so it also works inside running programs.
keybind = cmd+v=paste_from_clipboard
keybind = performable:cmd+shift+c=copy_to_clipboard

# Toggle between the configured glass background and an opaque background.
keybind = cmd+shift+o=toggle_background_opacity

# Reload without closing terminals.
keybind = cmd+shift+,=reload_config
