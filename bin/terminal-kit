#!/usr/bin/env bash
set -euo pipefail

# Keep terminal-kit functional when launched from cmux actions or other
# non-login contexts that receive a minimal PATH.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

resolve_script_dir() {
  local source_path="${BASH_SOURCE[0]}"
  while [[ -L "$source_path" ]]; do
    local directory
    directory="$(cd -P "$(dirname "$source_path")" && pwd)"
    source_path="$(readlink "$source_path")"
    [[ "$source_path" = /* ]] || source_path="$directory/$source_path"
  done
  cd -P "$(dirname "$source_path")" && pwd
}

BIN_DIR="$(resolve_script_dir)"
ROOT="$(cd "$BIN_DIR/.." && pwd)"
[[ -d "$ROOT" ]] || {
  printf 'terminal-kit: repository missing at %s\n' "$ROOT" >&2
  exit 1
}

has_git_checkout() {
  local toplevel
  [[ -e "$ROOT/.git" ]] || return 1
  toplevel="$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null)" || return 1
  [[ "$(cd -P "$toplevel" && pwd)" == "$ROOT" ]]
}

command_name="${1:-help}"
shift || true

case "$command_name" in
  recent)
    exec python3 "$ROOT/scripts/recent.py" "$@"
    ;;
  duo)
    exec /bin/bash "$ROOT/scripts/duo.sh" "$@"
    ;;
  install)
    exec /bin/bash "$ROOT/install.sh" "$@"
    ;;
  apply|reload)
    exec /bin/bash "$ROOT/scripts/apply.sh" "$@"
    ;;
  update|rollback)
    exec python3 "$ROOT/scripts/update.py" --root "$ROOT" "$command_name" "$@"
    ;;
  status)
    if ! has_git_checkout; then
      printf 'terminal-kit: checkout has no Git history at %s\n' "$ROOT"
      exit 0
    fi

    branch="$(git -C "$ROOT" branch --show-current 2>/dev/null || true)"
    changes="$(git -C "$ROOT" status --short)"
    stash_count="$(git -C "$ROOT" stash list | wc -l | tr -d '[:space:]')"

    printf 'terminal-kit: %s\n' "$ROOT"
    printf 'branch: %s\n' "${branch:-detached}"
    printf 'stashes: %s\n' "${stash_count:-0}"
    if [[ -n "$changes" ]]; then
      printf 'working tree:\n%s\n' "$changes"
    else
      printf 'working tree: clean\n'
    fi
    ;;
  work|do)
    exec /bin/bash "$ROOT/scripts/work-entry.sh" "$@"
    ;;
  agent|machine)
    exec /bin/bash "$ROOT/scripts/agent.sh" "$@"
    ;;
  karabiner|keymap)
    exec /bin/bash "$ROOT/scripts/karabiner.sh" "$@"
    ;;
  git|github)
    exec /bin/bash "$ROOT/scripts/git.sh" "$@"
    ;;
  cmux)
    exec /bin/bash "$ROOT/scripts/cmux-fork.sh" "$@"
    ;;
  theme|themes)
    exec /bin/bash "$ROOT/scripts/theme.sh" "$@"
    ;;
  set|settings)
    source "$ROOT/scripts/lib.sh"
    watched=("$HOME/.config/cmux/cmux.json" "$HOME/.config/terminal-kit/glass.ghostty")
    before="$(cat "${watched[@]}" 2>/dev/null | cksum)"
    python3 "$ROOT/scripts/settings.py" "$@"
    if [[ "$(cat "${watched[@]}" 2>/dev/null | cksum)" != "$before" ]]; then
      reload_cmux
    fi
    ;;
  glass|scroll|sidebar|editor|prompt|memory|ram)
    case "$command_name" in
      editor) key=wrap ;;
      ram) key=memory ;;
      *) key="$command_name" ;;
    esac
    printf 'terminal-kit: `tk %s` moved to `tk set %s <value>`; run `tk set` to list settings\n' "$command_name" "$key" >&2
    exit 2
    ;;
  copy|clipboard)
    exec /bin/bash "$ROOT/scripts/copy.sh" "$@"
    ;;
  overview|workspaces)
    exec /bin/bash "$ROOT/scripts/overview.sh" "$@"
    ;;
  template|templates)
    exec /usr/bin/env python3 "$ROOT/scripts/workspace_template.py" "$@"
    ;;
  hints|hint)
    exec /bin/bash "$ROOT/scripts/hints.sh" "$@"
    ;;
  keys|cheatsheet)
    exec /bin/bash "$ROOT/scripts/hints.sh" list
    ;;
  perf|performance)
    exec /bin/bash "$ROOT/scripts/perf.sh" "$@"
    ;;
  tools)
    exec /bin/bash "$ROOT/scripts/install-tools.sh" "$@"
    ;;
  doctor)
    exec /bin/bash "$ROOT/scripts/doctor.sh" "$@"
    ;;
  test)
    /bin/bash "$ROOT/scripts/test-copy.sh"
    /bin/bash "$ROOT/scripts/test-ergonomics.sh"
    /bin/bash "$ROOT/scripts/test-familiar-controls.sh"
    /bin/bash "$ROOT/scripts/test-prompt-clipboard.sh"
    exec /bin/bash "$ROOT/scripts/test.sh" "$@"
    ;;
  publish)
    exec /bin/bash "$ROOT/scripts/publish.sh" "$@"
    ;;
  uninstall)
    exec /bin/bash "$ROOT/scripts/uninstall.sh" "$@"
    ;;
  edit)
    if [[ -n "${EDITOR:-}" ]]; then
      exec "$EDITOR" "$ROOT"
    else
      exec open "$ROOT"
    fi
    ;;
  path)
    printf '%s\n' "$ROOT"
    ;;
  help|-h|--help)
    cat <<'HELP'
Usage: terminal-kit <command>

  update       Fetch and inspect; --apply FULL_SHA installs the exact inspected plan
  rollback     Restore the previous SOURCE revision (not installer host effects)
  status       Show the terminal-kit branch, stashes, and working-tree state
  work / do    Resolve a project, make a reversible task checkout, and launch an agent
  agent        Machine-facing context, policy, durable checkpoints, and task events
  karabiner    Export and sync portable Karabiner key mappings
  git          Choose SSH or HTTPS for GitHub Git operations
  cmux         Update, warm-build, or launch the canonical cmux checkout
  apply        Reload current files without pulling Git
  install      Repair includes and install missing tools
  set          List or change settings: scroll, wrap, prompt, memory, sidebar, glass
  theme        Browse, test, set, rotate, or automate cmux themes
  recent       Find and resume existing Claude/Codex conversations
  duo          Open Claude and Codex side by side for a project
  copy         Copy the last command, visible screen, current path, or project path
  overview     Browse every cmux window and workspace in one full-screen view
  template     Save a live cmux workspace as a layout template, or re-create one
  hints        Control temporary hints in cmux workspace rows
  keys         Print the compact hotkey and command cheat sheet
  perf         Benchmark and profile shell and cmux performance
  tools        Install recommended Homebrew packages
  doctor       Check files and commands
  test         Run repository checks
  publish      Create or push a public GitHub repository
  uninstall    Remove managed include blocks and command link
  edit         Open the repository
  path         Print the repository location

After Zsh loads the kit, plain `tk` inspects available updates. Use the printed exact apply command to install.
`tk do fix the tests` hands the current repo to an agent in a reversible task checkout.
Agents should bootstrap with `tk agent context --json` and record durable checkpoints.
Use `tk status` when you deliberately want Git branch, stash, and working-tree details.
HELP
    ;;
  *)
    printf 'terminal-kit: unknown command: %s\n' "$command_name" >&2
    exit 2
    ;;
esac
