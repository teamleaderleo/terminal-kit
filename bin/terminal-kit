#!/usr/bin/env bash
set -euo pipefail

resolve_script_dir() {
  local source_path="${BASH_SOURCE[0]}"
  while [[ -L "$source_path" ]]; do
    local directory
    directory="$(cd -P "$(dirname "$source_path")" && pwd)"
    source_path="$(readlink "$source_path")"
    [[ "$source_path" = /* ]] || source_path="$directory/$source_path"
  done
  cd -P "$(dirname "$source_path")" && pwd
}

BIN_DIR="$(resolve_script_dir)"
ROOT="$(cd "$BIN_DIR/.." && pwd)"
[[ -d "$ROOT" ]] || {
  printf 'terminal-kit: repository missing at %s\n' "$ROOT" >&2
  exit 1
}

command_name="${1:-help}"
shift || true

case "$command_name" in
  install)
    exec /bin/bash "$ROOT/install.sh" "$@"
    ;;
  apply|reload)
    exec /bin/bash "$ROOT/scripts/apply.sh" "$@"
    ;;
  update)
    if [[ -d "$ROOT/.git" ]]; then
      git -C "$ROOT" pull --ff-only
    else
      printf 'terminal-kit: this checkout has no Git history; applying current files\n'
    fi
    # Run the normal installer so additions to the Brewfile arrive through the
    # same one-command update. Homebrew skips packages that are already present.
    /bin/bash "$ROOT/install.sh"
    ;;
  status)
    if [[ ! -d "$ROOT/.git" ]]; then
      printf 'terminal-kit: checkout has no Git history at %s\n' "$ROOT"
      exit 0
    fi

    branch="$(git -C "$ROOT" branch --show-current 2>/dev/null || true)"
    changes="$(git -C "$ROOT" status --short)"
    stash_count="$(git -C "$ROOT" stash list | wc -l | tr -d '[:space:]')"

    printf 'terminal-kit: %s\n' "$ROOT"
    printf 'branch: %s\n' "${branch:-detached}"
    printf 'stashes: %s\n' "${stash_count:-0}"
    if [[ -n "$changes" ]]; then
      printf 'working tree:\n%s\n' "$changes"
    else
      printf 'working tree: clean\n'
    fi
    ;;
  theme|themes)
    exec /bin/bash "$ROOT/scripts/theme.sh" "$@"
    ;;
  glass)
    exec /bin/bash "$ROOT/scripts/glass.sh" "$@"
    ;;
  scroll)
    exec /bin/bash "$ROOT/scripts/scroll.sh" "$@"
    ;;
  sidebar)
    exec /bin/bash "$ROOT/scripts/sidebar.sh" "$@"
    ;;
  editor)
    exec /bin/bash "$ROOT/scripts/editor.sh" "$@"
    ;;
  hints|hint)
    exec /bin/bash "$ROOT/scripts/hints.sh" "$@"
    ;;
  keys|cheatsheet)
    exec /bin/bash "$ROOT/scripts/hints.sh" list
    ;;
  prompt)
    exec /bin/bash "$ROOT/scripts/prompt.sh" "$@"
    ;;
  tools)
    exec /bin/bash "$ROOT/scripts/install-tools.sh" "$@"
    ;;
  doctor)
    exec /bin/bash "$ROOT/scripts/doctor.sh" "$@"
    ;;
  test)
    exec /bin/bash "$ROOT/scripts/test.sh" "$@"
    ;;
  publish)
    exec /bin/bash "$ROOT/scripts/publish.sh" "$@"
    ;;
  uninstall)
    exec /bin/bash "$ROOT/scripts/uninstall.sh" "$@"
    ;;
  edit)
    if [[ -n "${EDITOR:-}" ]]; then
      exec "$EDITOR" "$ROOT"
    else
      exec open "$ROOT"
    fi
    ;;
  path)
    printf '%s\n' "$ROOT"
    ;;
  help|-h|--help)
    cat <<'HELP'
Usage: terminal-kit <command>

  update       Pull Git changes, install new tools, and reload terminal settings
  status       Show the terminal-kit branch, stashes, and working-tree state
  apply        Reload current files without pulling Git
  install      Repair includes and install missing tools
  theme        Browse, test, set, rotate, or automate cmux themes
  glass        Switch native macOS glass presets
  scroll       Tune cmux mouse-wheel and trackpad scroll speed
  sidebar      Tune the minimum width of cmux's left workspace sidebar
  editor       Toggle wrapping or horizontal scrolling in cmux's text editor
  hints        Control temporary hints in cmux workspace rows
  keys         Print the compact hotkey and command cheat sheet
  prompt       Enable or disable the compact contextual prompt
  tools        Install recommended Homebrew packages
  doctor       Check files and commands
  test         Run repository checks
  publish      Create or push a public GitHub repository
  uninstall    Remove managed include blocks and command link
  edit         Open the repository
  path         Print the repository location

After Zsh loads the kit, plain `tk` updates everything. `tk update` is the explicit form.
Run `tk status` to explain the Git symbols shown in the prompt.
HELP
    ;;
  *)
    printf 'terminal-kit: unknown command: %s\n' "$command_name" >&2
    exit 2
    ;;
esac
